#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <repository>"
    exit 1
fi

REPO="$1"

cd

ys-gclone "$REPO"

cd "$REPO"

mkdir -p ../work

rsync -a --exclude='.git' ./ ../work/

cd ../work

git init
git add .
git commit -m "Initial commit"

echo "Done: $(pwd)"

