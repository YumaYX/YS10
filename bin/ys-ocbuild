#!/usr/bin/env bash

if [[ ! -f Dockerfile ]]; then
    echo "Error: Dockerfile does not exist." >&2
    exit 1
fi

podman ps -a | grep -v CONTAINER | grep 'ocmyapp' | awk '{print $1}' | xargs -I@ podman rm @
podman image list | grep -v CONTAINER | grep 'ocmyapp' | awk '{print $1}' | xargs -I@ podman rmi @

podman build -t ocmyapp .

